Screen {
    layout: horizontal;
}

/* File picker screen */
FilePickerScreen {
    layout: vertical;
}

#picker-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#file-tree {
    height: 1fr;
    border: solid $primary;
    margin: 1 0;
}

#picker-buttons {
    height: 3;
    padding: 0 1;
}

#picker-buttons Button {
    min-width: 12;
    margin: 0 1;
}

#path-input {
    margin: 1 0;
}

#preview-container {
    width: 3fr;
    height: 100%;
    border: solid $primary;
}

#preview {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: auto;
}

#controls {
    width: 1fr;
    min-width: 35;
    max-width: 45;
    height: 100%;
    overflow-y: auto;
    padding: 1;
    border: solid $secondary;
}

.section-label {
    text-style: bold;
    color: $text;
    margin-top: 1;
    margin-bottom: 0;
}

.control-row {
    height: auto;
    margin-bottom: 0;
}

.control-label {
    width: 100%;
    height: 1;
    color: $text-muted;
}

Slider {
    margin: 0 1;
    height: 1;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#preset-bar {
    height: 3;
    layout: horizontal;
    padding: 0 1;
}

#preset-bar Button {
    min-width: 10;
    margin: 0 1;
}
